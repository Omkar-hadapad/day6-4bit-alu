//======================================================
// DAY 6 TESTBENCH : 4-BIT ALU
//======================================================

module day6_tb;

    reg [3:0] A;
    reg [3:0] B;
    reg [2:0] OP;

    wire [3:0] Y;
    wire COUT;


    //==================================================
    // DUT
    //==================================================

    alu_4bit DUT(
        .A(A),
        .B(B),
        .OP(OP),
        .Y(Y),
        .COUT(COUT)
    );


    //==================================================
    // TEST
    //==================================================

    initial begin

        $display("======================================");
        $display("        DAY 6 : 4-BIT ALU TEST");
        $display("======================================");


        // ---------------------------------------------
        // Test values
        // ---------------------------------------------

        A = 4'b0101;       // 5
        B = 4'b0011;       // 3


        // ---------------------------------------------
        // ADD
        // ---------------------------------------------

        OP = 3'b000;
        #10;

        $display("ADD : A=%d B=%d Y=%d COUT=%b",
                  A, B, Y, COUT);


        // ---------------------------------------------
        // SUBTRACT
        // ---------------------------------------------

        OP = 3'b001;
        #10;

        $display("SUB : A=%d B=%d Y=%d COUT=%b",
                  A, B, Y, COUT);


        // ---------------------------------------------
        // AND
        // ---------------------------------------------

        OP = 3'b010;
        #10;

        $display("AND : A=%b B=%b Y=%b",
                  A, B, Y);


        // ---------------------------------------------
        // OR
        // ---------------------------------------------

        OP = 3'b011;
        #10;

        $display("OR  : A=%b B=%b Y=%b",
                  A, B, Y);


        // ---------------------------------------------
        // XOR
        // ---------------------------------------------

        OP = 3'b100;
        #10;

        $display("XOR : A=%b B=%b Y=%b",
                  A, B, Y);


        // ---------------------------------------------
        // INCREMENT
        // ---------------------------------------------

        OP = 3'b101;
        #10;

        $display("INC : A=%d Y=%d COUT=%b",
                  A, Y, COUT);


        // ---------------------------------------------
        // DECREMENT
        // ---------------------------------------------

        OP = 3'b110;
        #10;

        $display("DEC : A=%d Y=%d COUT=%b",
                  A, Y, COUT);


        // ---------------------------------------------
        // PASS A
        // ---------------------------------------------

        OP = 3'b111;
        #10;

        $display("PASS: A=%d Y=%d",
                  A, Y);


        // ---------------------------------------------
        // Second test
        // ---------------------------------------------

        A = 4'b1111;       // 15
        B = 4'b0001;       // 1


        OP = 3'b000;
        #10;

        $display("ADD : A=%d B=%d Y=%d COUT=%b",
                  A, B, Y, COUT);


        // ---------------------------------------------
        // Third test
        // ---------------------------------------------

        A = 4'b1000;       // 8
        B = 4'b0010;       // 2


        OP = 3'b001;
        #10;

        $display("SUB : A=%d B=%d Y=%d COUT=%b",
                  A, B, Y, COUT);


        $display("======================================");
        $display("            TEST COMPLETE");
        $display("======================================");

        $finish;

    end

endmodule
